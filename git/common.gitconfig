# 両OS共通のGit設定。WSL側は home.nix の programs.git.includes から、
# Windows側は setup.ps1 が配置する ~/.gitconfig の [include] から読まれる。

[core]
    # pager = diff-so-fancy | less --tabs=4 -RFX
    # excludesfile = ~/.gitignore
    preloadindex = true
    autocrlf = false

[color]
    ui = auto

[color "diff"]
    # http://qiita.com/qurage/items/452f2debb64e2708a46c
    meta = 242 238
    frag = 239 236
    old = 167 normal
    new = 030 normal
    context = 240
    commit = 246 024

#[color "diff"]
#    meta = yellow bold
#    frag = magenta bold
#    old = red bold
#    new = green bold
#    whitespace = red reverse

[alias]
    st = status
    co = checkout
    ci = commit
    graph = log --graph --date-order --all --pretty=format:'%h %Cred%d %Cgreen%ad %Cblue%cn %Creset%s' --date=short
    br = switch
    # --- 自己レビュー用の3点セット ---
    # 「このブランチで自分が変えたところ」だけを見る。差分の書式が
    # A...B（ドット3つ）なのは、分岐点から HEAD までを対象にするため。
    # A..B だと他人が既定ブランチに入れた変更まで差分に混ざる。
    #
    # 既定ブランチは main / master のどちらもありうるので default-branch で
    # 解決する。origin/HEAD → origin/main → origin/master の順に見る。
    # 値の中の ; は INI のコメント開始と解釈されて切れるため使えない。
    # シェル関数として定義し、本体を " " で囲むことで回避する。
    default-branch = "!f() { git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null && return; for b in origin/main origin/master; do git rev-parse --verify --quiet $b >/dev/null && { echo $b; return; }; done; echo origin/main; }; f"

    # 自分の変更の差分そのもの
    review = !git diff $(git default-branch)...
    # 自分が触ったファイル名だけ
    review-files = !git diff $(git default-branch)... --name-only
    # 自分が積んだコミット一覧。
    # ここだけ .. （ドット2つ）なのは、log の ... が対称差（相手側の
    # コミットも含む）を意味するため。diff の ... とは意味が違う。
    lg = !git log --color=always --max-count=10 --oneline $(git default-branch)..HEAD

[help]
    autocorrect = 1

[push]
    # Use the Git 1.x.x default to avoid errors on machines with old Git
    # installations. To use `simple` instead, add this to your `~/.extra` file:
    # `git config --global push.default simple`. See http://git.io/mMah-w.
    default = matching

[github]
	user = rimoenic

[diff]
    algorithm           = histogram

[ghq]
    vcs = git
    # user = "rimoenic"
