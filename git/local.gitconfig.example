# git/local.gitconfig にコピーして使う。実体は .gitignore 済み。
#
# ユーザ情報を repo に入れないのは、会社用と個人用でメールアドレスが違い、
# マシンによって既定を変えたいため。

[user]
    name  = Your Name
    email = your@example.com

# ディレクトリごとに使い分けたい場合は includeIf を使う。
# ghq.root が ~/src なので、ホスト/オーナー単位で切り替えられる。
#
# [includeIf "gitdir:~/src/github.com/rimoenic/"]
#     path = ~/.dotfiles/git/personal.gitconfig

# 共有フォルダ上のリポジトリを開くと、所有者が違うため Git が
# "dubious ownership" として操作を拒否する。信頼するものをここに列挙する。
# マシンとネットワーク環境に依存するので repo には入れない。
#
# %(prefix)/ は UNC パスを書くときの決まり文句（file:// 相当の接頭辞）。
#
# [safe]
#     directory = %(prefix)///fileserver/share/path
#     directory = %(prefix)///198.51.100.10/share/path

# 社内ホストなど、資格情報の取得方式を指定したい場合
#
# [credential "https://git.example.com"]
#     provider = generic
